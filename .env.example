# 本地进程运行默认值（Docker 只跑 Postgres，监听 127.0.0.1:54329）。
# docker compose 部署时容器内由 docker-compose.yml 显式注入服务名地址，不受此处影响。
DATABASE_URL=postgres://zhiwei:zhiwei@127.0.0.1:54329/zhiwei
ANON_COOKIE_SECRET=
INTERNAL_MCP_TOKEN=
MEMORY_MCP_URL=http://127.0.0.1:4100/mcp
SCIENCE_MCP_URL=http://127.0.0.1:4200/mcp
MODEL_PROVIDER=scripted
MODEL_DIALOGUE_NAME=qwen-plus-character
MODEL_BACKGROUND_NAME=qwen3.8-flash
MODEL_EMBEDDING_NAME=qwen3.7-text-embedding
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_PRICING_REFRESH_HOURS=24
DEV_MODE=true
NEXT_PUBLIC_ACTIVITY_STREAM=true
