{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@zhiwei/core": ["packages/core/src/index.ts"],
      "@zhiwei/core/client": ["packages/core/src/client.ts"],
      "@zhiwei/model-gateway": ["packages/model-gateway/src/index.ts"],
      "@zhiwei/skills": ["packages/skills/src/index.ts"]
    }
  }
}
